{
  "expo": {
    "name": "Scrollark",
    "slug": "scrollark",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "scrollark",
    "android": {
      "package": "com.scrollark.app",
      "adaptiveIcon": {
        "backgroundColor": "#11110F",
        "foregroundImage": "./img/softicon.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-document-picker",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E6",
          "image": "./img/softicon.png",
          "imageWidth": 118,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#11110F",
            "image": "./img/softicon.png",
            "imageWidth": 118,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 Scrollark 访问相册，用于保存首页壁纸。",
          "savePhotosPermission": "允许 Scrollark 将首页壁纸保存到相册。",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ],
    "icon": "./img/softicon.png",
    "extra": {
      "eas": {
        "projectId": "63d083b0-91c9-4eb2-aa17-5104f82d36f3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/63d083b0-91c9-4eb2-aa17-5104f82d36f3"
    },
    "ios": {}
  }
}
